# Ignore SQLite databases and storage
/storage/*.sqlite3
/storage/*.sqlite3-journal
/storage/*.sqlite3-shm
/storage/*.sqlite3-wal
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-shm
/db/*.sqlite3-wal
/db/schema.rb~

# Ignore bundled gems and vendor directory
/vendor/bundle/
/vendor/ruby/
/.bundle/

# Ignore compiled assets and node modules
/public/assets
/public/packs
/public/packs-test
/node_modules/
/yarn-error.log

# Ignore logs and temporary files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore master key and credentials
/config/master.key
/config/credentials/*.key

# Ignore OS & IDE files
.DS_Store
.idea/
.vscode/
