<div id="<%= dom_id bet %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= bet.user_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Match card:</strong>
    <%= bet.match_card_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Chosen corner:</strong>
    <%= bet.chosen_corner %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Amount:</strong>
    <%= bet.amount %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= bet.status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Payout:</strong>
    <%= bet.payout %>
  </div>
</div>
