<div class="max-w-4xl mx-auto space-y-6">
  <div>
    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">My Betting History 🎟️</h1>
    <p class="text-sm text-slate-600 mt-1">Track your wagers across scheduled and completed fights.</p>
  </div>

  <% if @bets.empty? %>
    <div class="bg-white border-2 border-dashed border-slate-300 rounded-xl p-12 text-center">
      <p class="text-slate-500 text-sm">You haven't placed any bets yet.</p>
      <%= link_to "Explore Match Cards", root_path, class: "mt-4 inline-block px-4 py-2 bg-red-600 text-white text-sm font-bold rounded-lg" %>
    </div>
  <% else %>
    <div class="bg-white shadow rounded-xl overflow-hidden border border-slate-200">
      <table class="w-full text-left text-sm text-slate-700">
        <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 uppercase text-xs">
          <tr>
            <th class="p-4">Match Event</th>
            <th class="p-4">Chosen Corner</th>
            <th class="p-4">Wager Amount</th>
            <th class="p-4">Placed Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @bets.each do |bet| %>
            <tr class="hover:bg-slate-50">
              <td class="p-4 font-semibold text-slate-900"><%= bet.match_card.title %></td>
              <td class="p-4">
                <% if bet.chosen_corner == "red" %>
                  <span class="bg-red-100 text-red-800 text-xs font-bold px-2.5 py-0.5 rounded uppercase">🔴 Red Corner</span>
                <% else %>
                  <span class="bg-blue-100 text-blue-800 text-xs font-bold px-2.5 py-0.5 rounded uppercase">🔵 Blue Corner</span>
                <% end %>
              </td>
              <td class="p-4 font-mono font-bold text-amber-600">$<%= number_with_precision(bet.amount, precision: 2) %></td>
              <td class="p-4 text-xs text-slate-500"><%= bet.created_at.strftime("%b %d, %Y %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
