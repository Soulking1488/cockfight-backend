<%= form_with(model: bet, class: "contents") do |form| %>
  <% if bet.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(bet.errors.count, "error") %> prohibited this bet from being saved:</h2>

      <ul class="list-disc ml-6">
        <% bet.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :user_id %>
    <%= form.text_field :user_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": bet.errors[:user_id].none?, "border-red-400 focus:outline-red-600": bet.errors[:user_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :match_card_id %>
    <%= form.text_field :match_card_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": bet.errors[:match_card_id].none?, "border-red-400 focus:outline-red-600": bet.errors[:match_card_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :chosen_corner %>
    <%= form.text_field :chosen_corner, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": bet.errors[:chosen_corner].none?, "border-red-400 focus:outline-red-600": bet.errors[:chosen_corner].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :amount %>
    <%= form.text_field :amount, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": bet.errors[:amount].none?, "border-red-400 focus:outline-red-600": bet.errors[:amount].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :status %>
    <%= form.number_field :status, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": bet.errors[:status].none?, "border-red-400 focus:outline-red-600": bet.errors[:status].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :payout %>
    <%= form.text_field :payout, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": bet.errors[:payout].none?, "border-red-400 focus:outline-red-600": bet.errors[:payout].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
