<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">My Barn & Roster 🐓</h1>
      <p class="text-sm text-slate-600 mt-1">Manage your fighting roosters and monitor their fight records.</p>
    </div>
    <%= link_to "Register New Rooster", new_chicken_path, class: "bg-red-600 hover:bg-red-700 text-white font-medium px-4 py-2 rounded-lg shadow transition-colors text-sm flex items-center gap-1" %>
  </div>

  <% if @chickens.empty? %>
    <div class="bg-white border-2 border-dashed border-slate-300 rounded-xl p-12 text-center">
      <span class="text-4xl">🪹</span>
      <h3 class="mt-2 text-sm font-semibold text-slate-900">Your barn is empty</h3>
      <p class="mt-1 text-sm text-slate-500">You haven't registered any fighting roosters yet.</p>
      <div class="mt-6">
        <%= link_to "Register First Rooster", new_chicken_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700" %>
      </div>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @chickens.each do |chicken| %>
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md transition-shadow">
          <div class="p-5">
            <div class="flex items-start justify-between">
              <div>
                <span class="inline-block bg-amber-100 text-amber-800 text-xs font-semibold px-2.5 py-0.5 rounded-full mb-2">
                  <%= chicken.weight_class %>
                </span>
                <h3 class="text-xl font-bold text-slate-900"><%= chicken.name %></h3>
              </div>
              <span class="text-2xl">🐓</span>
            </div>

            <div class="mt-4 grid grid-cols-2 gap-2 text-sm border-t border-slate-100 pt-3">
              <div>
                <span class="text-slate-500 block text-xs">Weight</span>
                <span class="font-semibold text-slate-800"><%= chicken.weight %> kg</span>
              </div>
              <div>
                <span class="text-slate-500 block text-xs">Condition</span>
                <span class="font-semibold text-emerald-600"><%= chicken.status %></span>
              </div>
              <div class="col-span-2 mt-2 bg-slate-50 p-2 rounded-lg flex justify-between items-center text-xs">
                <span class="text-slate-500">Fight Record:</span>
                <span class="font-bold text-slate-800 font-mono">
                  <%= chicken.record_wins %> W - <%= chicken.record_losses %> L
                </span>
              </div>
            </div>

            <div class="mt-5 flex items-center justify-end space-x-3 pt-3 border-t border-slate-100 text-xs font-medium">
              <%= link_to "Edit Stats", edit_chicken_path(chicken), class: "text-slate-600 hover:text-slate-900" %>
              <%= button_to "Retire", chicken_path(chicken), method: :delete, data: { turbo_confirm: "Are you sure you want to retire #{chicken.name}?" }, class: "text-red-600 hover:text-red-800 cursor-pointer" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
