<%= form_with(model: chicken, class: "space-y-6") do |f| %>
  <% if chicken.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded text-red-700 text-sm">
      <p class="font-bold"><%= pluralize(chicken.errors.count, "error") %> prohibited this rooster from saving:</p>
      <ul class="list-disc list-inside mt-1">
        <% chicken.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Rooster Name / Alias", class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-slate-300 p-2.5 border shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm", placeholder: "e.g., General Tso", required: true %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :weight, "Weight (kg)", class: "block text-sm font-medium text-slate-700" %>
      <%= f.number_field :weight, step: 0.1, class: "mt-1 block w-full rounded-md border-slate-300 p-2.5 border shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm", placeholder: "2.5", required: true %>
    </div>

    <div>
      <%= f.label :weight_class, "Weight Class", class: "block text-sm font-medium text-slate-700" %>
      <%= f.select :weight_class, Chicken::WEIGHT_CLASSES, {}, class: "mt-1 block w-full rounded-md border-slate-300 p-2.5 border shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm" %>
    </div>
  </div>

  <div>
    <%= f.label :status, "Current Condition", class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :status, class: "mt-1 block w-full rounded-md border-slate-300 p-2.5 border shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm", placeholder: "Healthy / Feisty / Hungry" %>
  </div>

  <div class="flex justify-end gap-3 pt-4 border-t border-slate-200">
    <%= link_to "Cancel", chickens_path, class: "px-4 py-2 border border-slate-300 rounded-md text-sm font-medium text-slate-700 hover:bg-slate-50" %>
    <%= f.submit class: "px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-md text-sm font-medium cursor-pointer" %>
  </div>
<% end %>
