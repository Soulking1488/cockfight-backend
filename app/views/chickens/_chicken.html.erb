<div id="<%= dom_id chicken %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= chicken.user_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= chicken.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Weight:</strong>
    <%= chicken.weight %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Weight class:</strong>
    <%= chicken.weight_class %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Record wins:</strong>
    <%= chicken.record_wins %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Record losses:</strong>
    <%= chicken.record_losses %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= chicken.status %>
  </div>
</div>
