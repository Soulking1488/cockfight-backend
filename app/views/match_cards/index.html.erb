<div class="space-y-8">
  <div class="text-center max-w-2xl mx-auto">
    <h1 class="text-4xl font-black text-slate-900 tracking-tight">The Pit Arena 🥊</h1>
    <p class="text-slate-600 mt-2 text-sm">Place satire bets on premier underground cockfights. High stakes, zero real-world value!</p>
  </div>

  <!-- Scheduled Matches Grid -->
  <div>
    <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
      <span>🔥</span> Scheduled & Live Fights
    </h2>

    <% if @upcoming_matches.empty? %>
      <div class="bg-white border-2 border-dashed border-slate-300 rounded-xl p-12 text-center">
        <p class="text-slate-500 text-sm">No fight cards are currently scheduled by Pit Admins.</p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% @upcoming_matches.each do |match| %>
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md transition-shadow">
            <!-- Card Header -->
            <div class="bg-slate-900 text-white p-4 flex items-center justify-between">
              <span class="font-bold text-sm text-red-400"><%= match.title %></span>
              <span class="text-xs bg-slate-800 px-2.5 py-1 rounded-full text-slate-300 font-mono">
                <%= match.scheduled_at.strftime("%b %d, %H:%M") %>
              </span>
            </div>

            <!-- Faceoff Section -->
            <div class="p-6 grid grid-cols-2 gap-4 items-center text-center">
              <!-- Red Corner -->
              <div class="bg-red-50 p-4 rounded-xl border border-red-200">
                <span class="text-xs font-black text-red-600 uppercase tracking-widest block mb-1">🔴 Red</span>
                <p class="text-lg font-bold text-slate-900"><%= match.red_corner_chicken.name %></p>
                <p class="text-xs text-slate-500 mt-1"><%= match.red_corner_chicken.weight_class %></p>
                <div class="mt-3 bg-red-100 text-red-800 text-xs font-bold py-1 px-2 rounded-full font-mono">
                  <%= match.red_odds %>x Odds
                </div>
              </div>

              <!-- Blue Corner -->
              <div class="bg-blue-50 p-4 rounded-xl border border-blue-200">
                <span class="text-xs font-black text-blue-600 uppercase tracking-widest block mb-1">🔵 Blue</span>
                <p class="text-lg font-bold text-slate-900"><%= match.blue_corner_chicken.name %></p>
                <p class="text-xs text-slate-500 mt-1"><%= match.blue_corner_chicken.weight_class %></p>
                <div class="mt-3 bg-blue-100 text-blue-800 text-xs font-bold py-1 px-2 rounded-full font-mono">
                  <%= match.blue_odds %>x Odds
                </div>
              </div>
            </div>

            <!-- Footer Action -->
            <div class="bg-slate-50 border-t border-slate-100 p-4 flex justify-between items-center text-xs">
              <span class="text-slate-500">Total Pool: <strong class="text-slate-800 font-mono">$<%= number_with_delimiter(match.total_pool) %></strong></span>
              <%= link_to "Place Bet →", match_card_path(match), class: "bg-red-600 hover:bg-red-700 text-white font-bold px-4 py-2 rounded-lg transition-colors" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
