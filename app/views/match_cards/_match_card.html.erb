<div id="<%= dom_id match_card %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= match_card.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Scheduled at:</strong>
    <%= match_card.scheduled_at %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Red corner chicken:</strong>
    <%= match_card.red_corner_chicken_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Blue corner chicken:</strong>
    <%= match_card.blue_corner_chicken_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= match_card.status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Odds red:</strong>
    <%= match_card.odds_red %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Odds blue:</strong>
    <%= match_card.odds_blue %>
  </div>
</div>
