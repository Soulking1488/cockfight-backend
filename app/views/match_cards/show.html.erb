<div class="max-w-4xl mx-auto space-y-8">
  <%= link_to "← Back to Arena", match_cards_path, class: "text-slate-500 hover:text-slate-800 text-sm font-medium" %>

  <!-- Title & Status Header -->
  <div class="bg-slate-900 text-white p-6 rounded-2xl shadow-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
      <span class="text-xs bg-red-600 text-white px-2.5 py-1 rounded font-bold uppercase tracking-wider">Scheduled Fight</span>
      <h1 class="text-3xl font-extrabold mt-2"><%= @match_card.title %></h1>
      <p class="text-slate-400 text-sm mt-1">Event Scheduled: <%= @match_card.scheduled_at.strftime("%B %d, %Y at %I:%M %p") %></p>
    </div>
    <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 text-right font-mono">
      <span class="text-xs text-slate-400 uppercase block">Total Satire Pool</span>
      <span class="text-2xl font-bold text-amber-400">$<%= number_with_delimiter(@match_card.total_pool) %></span>
    </div>
  </div>

  <!-- User Active Bet Notice -->
  <% if @user_bet %>
    <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl flex justify-between items-center">
      <div>
        <p class="text-xs font-bold text-amber-800 uppercase">You have an active bet on this match!</p>
        <p class="text-sm text-amber-900 mt-0.5">
          Wagered <strong>$<%= @user_bet.amount %></strong> on the 
          <strong class="uppercase"><%= @user_bet.chosen_corner %> Corner</strong>
        </p>
      </div>
      <span class="text-2xl">🎟️</span>
    </div>
  <% end %>

  <!-- Fighter Comparison & Betting Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- RED CORNER CARD -->
    <div class="bg-white rounded-2xl border-2 border-red-500 overflow-hidden shadow-sm flex flex-col justify-between">
      <div class="p-6 bg-red-50/50">
        <div class="flex justify-between items-center mb-2">
          <span class="bg-red-600 text-white text-xs font-black px-3 py-1 rounded-full uppercase">Red Corner</span>
          <span class="text-sm font-bold font-mono text-red-700"><%= @match_card.red_odds %>x Multiplier</span>
        </div>
        <h2 class="text-2xl font-black text-slate-900"><%= @match_card.red_corner_chicken.name %></h2>
        <p class="text-xs text-slate-500 mt-1">Owner: <%= @match_card.red_corner_chicken.user.name %></p>

        <div class="mt-4 pt-4 border-t border-red-100 text-xs space-y-1 text-slate-700">
          <p><strong>Weight Class:</strong> <%= @match_card.red_corner_chicken.weight_class %></p>
          <p><strong>Weight:</strong> <%= @match_card.red_corner_chicken.weight %> kg</p>
          <p><strong>Record:</strong> <%= @match_card.red_corner_chicken.record_wins %>W - <%= @match_card.red_corner_chicken.record_losses %>L</p>
          <p><strong>Pool Contribution:</strong> $<%= number_with_delimiter(@match_card.total_red_pool) %></p>
        </div>
      </div>

      <!-- Bet Action -->
      <div class="p-6 bg-white border-t border-slate-100">
        <% if logged_in? %>
          <%= form_with(url: bets_path, class: "space-y-3") do |f| %>
            <%= f.hidden_field :match_card_id, value: @match_card.id %>
            <%= f.hidden_field :chosen_corner, value: "red" %>
            
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Bet Amount ($)</label>
              <div class="relative">
                <span class="absolute left-3 top-2.5 text-slate-400 font-bold">$</span>
                <%= f.number_field :amount, step: 5, min: 1, class: "pl-7 block w-full rounded-lg border-slate-300 border p-2 text-sm font-mono focus:ring-red-500 focus:border-red-500", placeholder: "50" %>
              </div>
            </div>

            <%= f.submit "Bet on Red Corner", class: "w-full py-2.5 px-4 bg-red-600 hover:bg-red-700 text-white font-bold text-sm rounded-lg shadow transition-colors cursor-pointer" %>
          <% end %>
        <% else %>
          <%= link_to "Log in to Bet", login_path, class: "block text-center w-full py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-lg" %>
        <% end %>
      </div>
    </div>

    <!-- BLUE CORNER CARD -->
    <div class="bg-white rounded-2xl border-2 border-blue-500 overflow-hidden shadow-sm flex flex-col justify-between">
      <div class="p-6 bg-blue-50/50">
        <div class="flex justify-between items-center mb-2">
          <span class="bg-blue-600 text-white text-xs font-black px-3 py-1 rounded-full uppercase">Blue Corner</span>
          <span class="text-sm font-bold font-mono text-blue-700"><%= @match_card.blue_odds %>x Multiplier</span>
        </div>
        <h2 class="text-2xl font-black text-slate-900"><%= @match_card.blue_corner_chicken.name %></h2>
        <p class="text-xs text-slate-500 mt-1">Owner: <%= @match_card.blue_corner_chicken.user.name %></p>

        <div class="mt-4 pt-4 border-t border-blue-100 text-xs space-y-1 text-slate-700">
          <p><strong>Weight Class:</strong> <%= @match_card.blue_corner_chicken.weight_class %></p>
          <p><strong>Weight:</strong> <%= @match_card.blue_corner_chicken.weight %> kg</p>
          <p><strong>Record:</strong> <%= @match_card.blue_corner_chicken.record_wins %>W - <%= @match_card.blue_corner_chicken.record_losses %>L</p>
          <p><strong>Pool Contribution:</strong> $<%= number_with_delimiter(@match_card.total_blue_pool) %></p>
        </div>
      </div>

      <!-- Bet Action -->
      <div class="p-6 bg-white border-t border-slate-100">
        <% if logged_in? %>
          <%= form_with(url: bets_path, class: "space-y-3") do |f| %>
            <%= f.hidden_field :match_card_id, value: @match_card.id %>
            <%= f.hidden_field :chosen_corner, value: "blue" %>
            
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Bet Amount ($)</label>
              <div class="relative">
                <span class="absolute left-3 top-2.5 text-slate-400 font-bold">$</span>
                <%= f.number_field :amount, step: 5, min: 1, class: "pl-7 block w-full rounded-lg border-slate-300 border p-2 text-sm font-mono focus:ring-blue-500 focus:border-blue-500", placeholder: "50" %>
              </div>
            </div>

            <%= f.submit "Bet on Blue Corner", class: "w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm rounded-lg shadow transition-colors cursor-pointer" %>
          <% end %>
        <% else %>
          <%= link_to "Log in to Bet", login_path, class: "block text-center w-full py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-lg" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
