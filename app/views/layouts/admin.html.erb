<!DOCTYPE html>
<html>
  <head>
    <title>Admin Pit Control - Cockfight Arena</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-900 text-slate-100 antialiased min-h-screen flex flex-col">
    <!-- Admin Header -->
    <header class="bg-slate-950 border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="bg-red-600 text-white text-xs font-black px-2 py-1 rounded">ADMIN CONTROL</span>
          <%= link_to "Cockfight Underground", admin_dashboard_path, class: "font-bold text-lg text-slate-200" %>
        </div>

        <nav class="flex items-center space-x-6 text-sm">
          <%= link_to "Dashboard", admin_dashboard_path, class: "text-slate-300 hover:text-white" %>
          <%= link_to "Schedule Match", new_admin_match_card_path, class: "text-slate-300 hover:text-white" %>
          <%= link_to "Manage Users", admin_users_path, class: "text-slate-300 hover:text-white" %>
          <%= link_to "Exit to Arena", root_path, class: "text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-3 py-1.5 rounded" %>
        </nav>
      </div>
    </header>

    <!-- Flash Notifications -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-4">
      <% if notice %>
        <div class="bg-emerald-900/80 border border-emerald-600 text-emerald-200 px-4 py-3 rounded mb-4">
          <%= notice %>
        </div>
      <% end %>
      <% if alert %>
        <div class="bg-red-900/80 border border-red-600 text-red-200 px-4 py-3 rounded mb-4">
          <%= alert %>
        </div>
      <% end %>
    </div>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <%= yield %>
    </main>
  </body>
</html>
