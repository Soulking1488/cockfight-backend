<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-xl shadow-lg border border-slate-100">
    <div>
      <h2 class="text-center text-3xl font-extrabold text-slate-900 tracking-tight">
        Enter the Pit 🐓
      </h2>
      <p class="mt-2 text-center text-sm text-slate-600">
        Register your account and claim your <span class="font-bold text-amber-600">$1,000 Satire Bucks</span> starting balance.
      </p>
    </div>

    <%= form_with(model: @user, url: signup_path, class: "mt-8 space-y-6") do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded text-red-700 text-sm space-y-1">
          <p class="font-bold"><%= pluralize(@user.errors.count, "error") %> prohibited this account from being saved:</p>
          <ul class="list-disc list-inside">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-4">
        <div>
          <%= f.label :name, "Owner / Handler Name", class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm p-2.5 border", placeholder: "El Gallo Loco", required: true %>
        </div>

        <div>
          <%= f.label :email, "Email Address", class: "block text-sm font-medium text-slate-700" %>
          <%= f.email_field :email, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm p-2.5 border", placeholder: "owner@cockfight.local", required: true %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-slate-700" %>
          <%= f.password_field :password, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm p-2.5 border", required: true %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-slate-700" %>
          <%= f.password_field :password_confirmation, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm p-2.5 border", required: true %>
        </div>
      </div>

      <div>
        <%= f.submit "Register & Get Funded", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 cursor-pointer transition-colors" %>
      </div>
    <% end %>

    <div class="text-center text-sm text-slate-500">
      Already have a barn? 
      <%= link_to "Log in here", login_path, class: "font-semibold text-red-600 hover:text-red-500" %>
    </div>
  </div>
</div>
