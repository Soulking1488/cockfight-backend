<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-white tracking-tight">Book a New Fight Card 🥊</h1>
      <p class="text-sm text-slate-400 mt-1">Select fighters from active barns and configure the House Starting Pool.</p>
    </div>
    <%= link_to "← Back to Dashboard", admin_dashboard_path, class: "text-slate-400 hover:text-white text-sm font-medium" %>
  </div>

  <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 sm:p-8 shadow-xl">
    <%= form_with(model: [:admin, @match_card], class: "space-y-6") do |f| %>
      <% if @match_card.errors.any? %>
        <div class="bg-red-900/60 border border-red-500 text-red-200 p-4 rounded-lg text-sm space-y-1">
          <p class="font-bold"><%= pluralize(@match_card.errors.count, "error") %> prohibited this fight from being booked:</p>
          <ul class="list-disc list-inside">
            <% @match_card.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Fight Title & Event Time -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-2">
          <%= f.label :title, "Match Event Name / Title", class: "block text-sm font-medium text-slate-300" %>
          <%= f.text_field :title, class: "mt-1.5 block w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white placeholder-slate-500 focus:ring-red-500 focus:border-red-500 text-sm", placeholder: "e.g., Clash of the Featherweights - Main Event", required: true %>
        </div>

        <div>
          <%= f.label :scheduled_at, "Schedule Date & Time", class: "block text-sm font-medium text-slate-300" %>
          <%= f.datetime_field :scheduled_at, class: "mt-1.5 block w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:ring-red-500 focus:border-red-500 text-sm", required: true %>
        </div>
      </div>

      <!-- Fighter Selection: Red Corner vs Blue Corner -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-700">
        <!-- RED CORNER -->
        <div class="bg-red-950/40 border border-red-800/60 p-5 rounded-xl space-y-4">
          <div class="flex items-center justify-between border-b border-red-800/40 pb-2">
            <span class="text-red-400 font-extrabold tracking-wider text-sm">🔴 RED CORNER</span>
            <span class="text-xs bg-red-900 text-red-200 px-2 py-0.5 rounded font-mono">Fighter 1</span>
          </div>

          <div>
            <%= f.label :red_corner_chicken_id, "Select Rooster", class: "block text-xs font-semibold text-slate-300 uppercase mb-1" %>
            <%= f.collection_select :red_corner_chicken_id, @chickens, :id, lambda { |c| "#{c.name} (#{c.weight_class} - #{c.user.name})" }, { prompt: "Choose Red Fighter..." }, { class: "block w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:ring-red-500 text-sm", required: true } %>
          </div>

          <div>
            <%= f.label :house_bet_red, "House Seed Bet ($)", class: "block text-xs font-semibold text-slate-300 uppercase mb-1" %>
            <%= f.number_field :house_bet_red, step: 10, class: "block w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-amber-400 font-mono text-sm focus:ring-red-500", placeholder: "100.00" %>
            <p class="text-[11px] text-slate-400 mt-1">House money added to seed Red Corner payout odds.</p>
          </div>
        </div>

        <!-- BLUE CORNER -->
        <div class="bg-blue-950/40 border border-blue-800/60 p-5 rounded-xl space-y-4">
          <div class="flex items-center justify-between border-b border-blue-800/40 pb-2">
            <span class="text-blue-400 font-extrabold tracking-wider text-sm">🔵 BLUE CORNER</span>
            <span class="text-xs bg-blue-900 text-blue-200 px-2 py-0.5 rounded font-mono">Fighter 2</span>
          </div>

          <div>
            <%= f.label :blue_corner_chicken_id, "Select Rooster", class: "block text-xs font-semibold text-slate-300 uppercase mb-1" %>
            <%= f.collection_select :blue_corner_chicken_id, @chickens, :id, lambda { |c| "#{c.name} (#{c.weight_class} - #{c.user.name})" }, { prompt: "Choose Blue Fighter..." }, { class: "block w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:ring-blue-500 text-sm", required: true } %>
          </div>

          <div>
            <%= f.label :house_bet_blue, "House Seed Bet ($)", class: "block text-xs font-semibold text-slate-300 uppercase mb-1" %>
            <%= f.number_field :house_bet_blue, step: 10, class: "block w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-amber-400 font-mono text-sm focus:ring-blue-500", placeholder: "100.00" %>
            <p class="text-[11px] text-slate-400 mt-1">House money added to seed Blue Corner payout odds.</p>
          </div>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="pt-4 flex justify-end gap-3 border-t border-slate-700">
        <%= link_to "Cancel", admin_dashboard_path, class: "px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg text-sm font-medium transition-colors" %>
        <%= f.submit "Book Fight Card", class: "px-6 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-bold shadow-lg transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
