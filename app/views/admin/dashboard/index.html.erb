<div class="space-y-8">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Pit Manager Dashboard 🚨</h1>
      <p class="text-slate-400 text-sm mt-1">Control match cards, monitor user bets, and oversee underground fights.</p>
    </div>
    <%= link_to "Create Match Card", new_admin_match_card_path, class: "bg-red-600 hover:bg-red-700 text-white text-sm font-semibold px-4 py-2 rounded-lg shadow transition-colors" %>
  </div>

  <!-- Metric Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-slate-800 border border-slate-700 p-5 rounded-xl">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Total Owners</span>
      <span class="text-3xl font-bold text-white mt-1 block"><%= @total_users %></span>
    </div>

    <div class="bg-slate-800 border border-slate-700 p-5 rounded-xl">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Registered Roosters</span>
      <span class="text-3xl font-bold text-amber-400 mt-1 block">🐓 <%= @total_chickens %></span>
    </div>

    <div class="bg-slate-800 border border-slate-700 p-5 rounded-xl">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Total Fights Scheduled</span>
      <span class="text-3xl font-bold text-red-400 mt-1 block">🥊 <%= @total_matches %></span>
    </div>

    <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 mt-6">
  <h2 class="text-lg font-bold text-white mb-4">Scheduled Match Cards</h2>
  <div class="divide-y divide-slate-700">
    <% @upcoming_matches.each do |match| %>
      <div class="py-4 flex items-center justify-between">
        <div>
          <span class="text-xs font-mono text-red-400 block"><%= match.scheduled_at.strftime("%b %d, %H:%M") %></span>
          <p class="text-white font-bold"><%= match.title %></p>
          <p class="text-xs text-slate-400">
            🔴 <%= match.red_corner_chicken.name %> vs 🔵 <%= match.blue_corner_chicken.name %>
          </p>
        </div>
        <div>
          <% if match.completed? %>
            <span class="text-xs bg-slate-700 text-slate-300 px-3 py-1 rounded-full font-semibold">Completed</span>
          <% else %>
            <%= link_to "Settle Fight & Pay", new_admin_match_card_match_result_path(match), class: "bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-3 py-2 rounded-lg transition-colors" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

    <div class="bg-slate-800 border border-slate-700 p-5 rounded-xl">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Total Bets Pool</span>
      <span class="text-3xl font-bold text-emerald-400 mt-1 block font-mono">$<%= number_with_delimiter(@total_bets_volume) %></span>
    </div>
  </div>

  <!-- Recent Roosters Section -->
  <div class="bg-slate-800 border border-slate-700 rounded-xl p-6">
    <h2 class="text-lg font-bold text-white mb-4">Recently Entered Fighting Roosters</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-300">
        <thead class="bg-slate-900/50 text-slate-400 uppercase text-xs">
          <tr>
            <th class="p-3">Rooster Name</th>
            <th class="p-3">Owner</th>
            <th class="p-3">Weight Class</th>
            <th class="p-3">Weight</th>
            <th class="p-3">Record</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-700">
          <% @recent_chickens.each do |chicken| %>
            <tr class="hover:bg-slate-700/50">
              <td class="p-3 font-semibold text-white"><%= chicken.name %></td>
              <td class="p-3 text-slate-400"><%= chicken.user.name %></td>
              <td class="p-3"><span class="bg-slate-700 px-2 py-0.5 rounded text-xs text-amber-300"><%= chicken.weight_class %></span></td>
              <td class="p-3"><%= chicken.weight %> kg</td>
              <td class="p-3 font-mono text-xs"><%= chicken.record_wins %>W - <%= chicken.record_losses %>L</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
