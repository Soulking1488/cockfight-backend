<div id="<%= dom_id match_result %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Match card:</strong>
    <%= match_result.match_card_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Winning chicken:</strong>
    <%= match_result.winning_chicken_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Win method:</strong>
    <%= match_result.win_method %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Duration seconds:</strong>
    <%= match_result.duration_seconds %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Admin notes:</strong>
    <%= match_result.admin_notes %>
  </div>
</div>
